# ──────────────────────────────────────────────────────────────
# Affiliate landing page configuration
# Copy this file to `.env.local` (local dev) or set these
# variables in your Vercel project settings.
# ──────────────────────────────────────────────────────────────

# YOUR Digistore24 affiliate link (must start with https://).
# Every CTA on the site points to this ONE value.
# Leave empty while developing — CTAs will show a helpful notice.
NEXT_PUBLIC_AFFILIATE_URL=https://www.digistore24.com/redir/292043/ganeshyam_verma/

# Production domain, used for the canonical URL, sitemap and Open Graph.
# Replace https://your-domain.com before launch.
NEXT_PUBLIC_SITE_URL=https://ketoafter50.vercel.app/
